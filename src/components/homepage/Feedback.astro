---
import { Image } from "astro:assets";
import { Icon } from "astro-icon/components";
import Swiper from "../Swiper.astro";

const testimonials = [
  {
    name: "Robert Fox",
    role: "Business Owner",
    avatar: "/img/comments/cmnt1.webp",
    rating: 5,
    text: "Excellent service! The team was punctual, thorough, and left our office space sparkling clean every week. Highly recommend them for anyone needing a reliable commercial cleaning partner."
  },
  {
    name: "Sarah Jenkins",
    role: "Homeowner",
    avatar: "/img/comments/cmnt2.webp",
    rating: 5,
    text: "With two kids and pets, keeping the house clean was overwhelming. SparkClean does an immaculate job with eco-friendly products that are safe for our entire family. A true lifesaver!"
  },
  {
    name: "David Miller",
    role: "Facility Manager",
    avatar: "/img/comments/cmnt3.webp",
    rating: 5,
    text: "We booked their deep spring cleaning service and were blown away by the attention to detail. Every baseboard, vent, and corner was spotless. Professional and courteous crew."
  },
  {
    name: "Emily Watson",
    role: "Creative Director",
    avatar: "/img/comments/cmnt4.webp",
    rating: 5,
    text: "Consistent quality every single visit. Their online booking is seamless, pricing is transparent with zero hidden fees, and the cleaners always arrive on time with complete gear."
  },
  {
    name: "Michael Chang",
    role: "Property Manager",
    avatar: "/img/comments/cmnt5.webp",
    rating: 5,
    text: "We rely on SparkClean for all our tenant move-out turnarounds. They deliver consistent 5-star results quickly, helping us get properties back on the market with zero delays."
  }
];
---

<section class="section section-reviews">
  <div class="container">
    <div class="grid grid-cols-1 md:grid-cols-2 gap-10 items-center">
      <div>
        <h2>Feedback About Their Experience With Us</h2>
        <p class="mt-4">
          Read testimonials from our satisfied clients. See how our cleaning
          services have made a difference in their lives and homes.
        </p>
      </div>
      <div>
        <Swiper
          pagination={false}
          navigation={true}
          id="mySwiper"
          prev="swiper-prev"
          next="swiper-next"
        >
          {
            testimonials.map((item) => (
              <div class="swiper-slide">
                <article
                  class="rounded-xl p-8 sm:p-10 grid grid-cols-1 sm:grid-cols-[90px_1fr] gap-5 items-center border border-gray-200 dark:border-gray-800 border-t-4 border-t-main border-r-4 border-r-main bg-white dark:bg-dark relative shadow-sm"
                >
                  <div class="w-20 h-20 rounded-full overflow-hidden shrink-0 border-2 border-main/30 mx-auto sm:mx-0">
                    <Image
                      src={item.avatar}
                      alt={item.name}
                      format="webp"
                      quality={90}
                      width={160}
                      height={160}
                      class="w-full h-full object-cover"
                    />
                  </div>
                  <div class="grid gap-1">
                    <div class="flex flex-wrap justify-between items-center gap-4">
                      <div>
                        <p class="text-lg font-semibold">{item.name}</p>
                        <p class="text-sm text-gray-500 dark:text-gray-400">{item.role}</p>
                      </div>
                      <Image
                        src="/img/icons/quote.svg"
                        width={40}
                        height={40}
                        alt="quote"
                        class="w-8 h-8 opacity-40 absolute top-4 right-4"
                      />
                    </div>

                    <div class="flex gap-1 items-center text-yellow-500 my-2">
                      {
                        Array.from({ length: item.rating }).map(() => (
                          <Icon name="heroicons:star-solid" size={20} />
                        ))
                      }
                    </div>

                    <p class="text-sm text-gray-700 dark:text-gray-300 leading-relaxed">
                      "{item.text}"
                    </p>
                  </div>
                </article>
              </div>
            ))
          }
        </Swiper>
      </div>
    </div>
  </div>
</section>

<script>
  import Swiper from "swiper";
  import { Navigation } from "swiper/modules";

  new Swiper("#mySwiper", {
    modules: [Navigation],
    loop: true,

    navigation: {
      nextEl: ".swiper-next",
      prevEl: ".swiper-prev",
    },
  });
</script>
