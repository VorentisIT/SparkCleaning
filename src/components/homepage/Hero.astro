---
import { Image } from "astro:assets";
---

<section
  class="section-hero bg-gray-50 py-10 lg:py-20 bg-no-repeat bg-cover relative overflow-hidden z-0"
>
  <Image
    src="/img/bg/bg0.webp"
    alt=""
    width={1920}
    height={1080}
    loading="eager"
    fetchpriority="high"
    format="webp"
    quality={90}
    class="absolute inset-0 w-full h-full object-cover object-bottom -z-10"
  />
  <!-- White background only on the left side behind the text -->
  <div
    class="absolute inset-y-0 left-0 w-full sm:w-3/5 md:w-1/2 lg:w-5/12 bg-gradient-to-r from-white/95 via-white/85 to-transparent dark:from-dark/95 dark:via-dark/85 dark:to-transparent -z-10 pointer-events-none"
  ></div>
  <div class="container z-10">
    <div class="sm:max-w-md md:max-w-xl text-center sm:text-left">
      <p class="text-sm mb-1">Quality cleaning at a fair price.</p>
      <h1>Specialized, efficient, and thorough cleaning services</h1>
      <p>
        We provide Performing cleaning tasks using the least amount of time,
        energy, and money.
      </p>
      <div class="mt-6 grid grid-cols-2 gap-4 max-w-sm mx-auto sm:mx-0">
        <a
          href="/contact"
          class="btn bg-main border-main text-white rounded-lg hover:bg-green-600"
          >Get Start Now</a
        >
        <a
          href="/service"
          class="btn btn-outline hover:bg-white hover:border-white rounded-lg"
          >View all Services</a
        >
      </div>
    </div>
  </div>
</section>
