---
import { Image } from "astro:assets";
import { Icon } from "astro-icon/components";
---

<!-- Page Header Banner -->
<section
  class="section-hero bg-gray-50 dark:bg-dark/80 py-8 lg:py-12 bg-no-repeat bg-cover relative overflow-hidden z-0"
>
  <Image
    src="/img/bg/bg0.webp"
    alt=""
    width={1200}
    height={500}
    loading="eager"
    fetchpriority="high"
    format="webp"
    quality={45}
    class="absolute inset-0 w-full h-full object-cover object-top -z-10 opacity-30"
  />
  <div class="container z-10 text-center max-w-2xl">
    <p class="text-sm text-black dark:text-white font-medium uppercase tracking-wider mb-1">About SparkClean</p>
    <h1 class="text-3xl sm:text-4xl lg:text-5xl font-bold">Reliable Cleaning You Can Count On</h1>
    <p class="mt-2 text-base text-gray-700 dark:text-gray-300">
      We make spaces cleaner, fresher, and healthier with dependable service, friendly staff, and upfront pricing.
    </p>
  </div>
</section>

<!-- Story Section -->
<section class="py-8 lg:py-12">
  <div class="container">
    <div class="grid grid-cols-1 md:grid-cols-2 gap-8 items-center">
      <Image
        src="/img/img2.webp"
        alt="SparkClean professional cleaning team"
        width="1070"
        height="884"
        format="webp"
        quality={95}
        class="w-auto h-auto m-auto rounded-lg shadow-sm"
      />
      <div>
        <p class="text-sm text-black dark:text-white font-medium mb-1">Who We Are</p>
        <h2>Passionate About Clean Homes & Healthy Workplaces</h2>
        <p class="mt-3 text-gray-700 dark:text-gray-300">
          SparkClean started with a straightforward goal: give people their free time back by taking care of the cleaning with care, honesty, and consistency.
        </p>
        <p class="mt-2 text-gray-700 dark:text-gray-300">
          Whether it is routine apartment upkeep or commercial facility sanitization, our team treats your space like their own, ensuring every corner is spotless.
        </p>

        <div class="grid grid-cols-1 sm:grid-cols-2 my-5 gap-3">
          <div class="grid grid-cols-[20px_1fr] items-center bg-gray-50 dark:bg-dark p-3.5 rounded gap-3">
            <div class="bg-main text-white rounded-full flex items-center justify-center w-5 h-5">
              <Icon name="lucide:check" />
            </div>
            <p class="font-semibold text-base">Trained Cleaners</p>
          </div>

          <div class="grid grid-cols-[20px_1fr] items-center bg-gray-50 dark:bg-dark p-3.5 rounded gap-3">
            <div class="bg-main text-white rounded-full flex items-center justify-center w-5 h-5">
              <Icon name="lucide:check" />
            </div>
            <p class="font-semibold text-base">Eco-Friendly Supplies</p>
          </div>

          <div class="grid grid-cols-[20px_1fr] items-center bg-gray-50 dark:bg-dark p-3.5 rounded gap-3">
            <div class="bg-main text-white rounded-full flex items-center justify-center w-5 h-5">
              <Icon name="lucide:check" />
            </div>
            <p class="font-semibold text-base">Punctual & Reliable</p>
          </div>

          <div class="grid grid-cols-[20px_1fr] items-center bg-gray-50 dark:bg-dark p-3.5 rounded gap-3">
            <div class="bg-main text-white rounded-full flex items-center justify-center w-5 h-5">
              <Icon name="lucide:check" />
            </div>
            <p class="font-semibold text-base">Fair & Simple Pricing</p>
          </div>
        </div>

        <div class="mt-5 flex flex-wrap gap-4">
          <a
            href="/contact"
            class="btn bg-main border-main text-white rounded-lg hover:bg-green-600"
            >Contact Us</a
          >
          <a href="/service" class="btn btn-outline rounded-lg">View Services</a>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- Section 2: Our Commitment -->
<section class="py-8 lg:py-12 bg-gray-50 dark:bg-dark/40">
  <div class="container">
    <div class="grid grid-cols-1 md:grid-cols-2 gap-8 items-center">
      <div class="order-2 md:order-1">
        <p class="text-sm text-black dark:text-white font-medium mb-1">Our Commitment</p>
        <h2>High Standards in Every Single Room</h2>
        <p class="mb-3 text-gray-700 dark:text-gray-300">
          We use safe, proven cleaning supplies that leave no harsh fumes behind. From dusting shelves to deep mopping, our checklist ensures nothing is missed.
        </p>
        <p class="mb-5 text-gray-700 dark:text-gray-300">
          Need a custom checklist or have specific preferences? Just let us know during booking and we will tailor everything to your needs.
        </p>
        <a
          href="/contact"
          class="btn bg-main border-main text-white rounded-lg hover:bg-green-600"
          >Get a Free Quote</a
        >
      </div>
      <div class="order-1 md:order-2 flex justify-center">
        <Image
          src="/img/img1.webp"
          alt="Cleaning in action"
          width={420}
          height={370}
          format="webp"
          quality={90}
          class="w-full max-w-[380px] sm:max-w-[420px] h-auto m-auto rounded-2xl shadow-sm object-contain"
        />
      </div>
    </div>
  </div>
</section>

<!-- Simple CTA Banner -->
<section class="py-8 lg:py-12 text-center">
  <div class="container max-w-xl">
    <h2>Ready For a Sparkling Clean Space?</h2>
    <p class="mt-2 mb-5 text-gray-700 dark:text-gray-300">
      Schedule your cleaning today or get in touch for custom commercial or residential plans.
    </p>
    <a
      href="/contact"
      class="btn bg-main border-main text-white rounded-lg hover:bg-green-600 px-8"
      >Book an Appointment</a
    >
  </div>
</section>
