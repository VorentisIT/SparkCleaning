---
import { Image } from "astro:assets";
import { Icon } from "astro-icon/components";

const { data, id } = Astro.props;
---

<article class="flex flex-col h-full">
  <a href={`/service/${id}`} class="group block flex-1 flex flex-col">
    <div class="w-full overflow-hidden rounded-xl bg-gray-100 dark:bg-dark mb-4 aspect-[16/10] flex items-center justify-center">
      <Image
        src={data.thumbnail}
        alt={data.title}
        width={800}
        height={500}
        format="webp"
        quality={90}
        class="w-full h-full object-cover transition-transform duration-300 group-hover:scale-105"
      />
    </div>

    <h3 class="font-semibold text-xl sm:text-2xl my-3 group-hover:text-main transition-colors">{data.title}</h3>
    <p class="mb-4 text-sm sm:text-base text-gray-600 dark:text-gray-300 flex-1">{data.description}</p>

    <div class="mt-auto">
      <span
        class="btn btn-outline hover:bg-main hover:text-white hover:border-main rounded-lg inline-flex items-center gap-2"
      >
        Book Now
        <Icon name="lucide:arrow-up-right" size={16} />
      </span>
    </div>
  </a>
</article>
