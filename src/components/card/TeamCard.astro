---
import { Image } from "astro:assets";
import { Icon } from "astro-icon/components";

const { id, data } = Astro.props;
---

<article class="group">
  <a href={`/team/${id}`}>
    <div
      class="rounded-xl overflow-hidden w-full mb-4 aspect-[370/300] bg-gray-100 dark:bg-dark shadow-sm"
    >
      <Image
        src={data.thumbnail}
        alt={data.title}
        width={740}
        height={600}
        format="webp"
        quality={95}
        class="w-full h-full object-cover transition-transform duration-300 group-hover:scale-105"
      />
    </div>
    <h3 class="font-semibold text-xl sm:text-2xl group-hover:underline">
      {data.title}
    </h3>

    <div class="flex gap-1 items-center text-yellow-500 my-2">
      {
        Array.from({ length: data.rating }).map((star) => (
          <Icon name="heroicons:star-solid" size={24} />
        ))
      }
    </div>

    <p class="mt-4 text-sm sm:text-base text-gray-600 dark:text-gray-300">{data.description}</p>
  </a>
  <div class="flex flex-wrap justify-start gap-x-6 gap-y-2 items-center mt-4">
    <a
      href="https://wa.me/916239796319"
      target="_blank"
      rel="noopener noreferrer"
      title="WhatsApp"
      class="hover:-rotate-12 transition-transform"
    >
      <Icon name="simple-icons:whatsapp" size={20} />
    </a>
  </div>
</article>
